{
  "name": "served-frontend",
  "version": "1.0.0",
  "description": "Frontend for served media server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --loader tsx/esm src/server.ts",
    "build": "tsc && tailwindcss -i src/styles/input.css -o dist/styles/output.css",
    "start": "node dist/server.js"
  },
  "type": "module",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "lucide": "^0.408.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "tsx": "^4.15.0"
  }
}
